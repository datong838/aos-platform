  "sql": "SELECT h.reservation_id,h.approval_ref->>'contentHash' AS expected,\n 'sha256:'||encode(sha256(convert_to(public.canonical_asset_registry_jsonb(jsonb_build_object(\n 'approval_event_id',a.approval_event_id,'proposal_id',a.proposal_id,'proposal_version',a.proposal_version,\n 'proposal_hash',a.proposal_hash,'decision',a.decision,'actor_id',a.actor_id,'reason',a.reason,\n 'expires_at',to_char(a.expires_at AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI:SS') || CASE WHEN extract(microseconds FROM a.expires_at)::bigint%1000000=0 THEN '' ELSE '.'||to_char(a.expires_at,'US') END || '+00:00',\n 'created_at',to_char(a.created_at AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI:SS') || CASE WHEN extract(microseconds FROM a.created_at)::bigint%1000000=0 THEN '' ELSE '.'||to_char(a.created_at,'US') END || '+00:00',\n 'action_binding_hash',a.action_binding_hash)),'UTF8')),'hex') AS actual\n FROM aip_model_judge_budget_reservation h JOIN aip_action_approval_event a USING(org_id,project_id,approval_event_id)",
