            },
            {
              "PLpgSQL_stmt_if": {
                "lineno": 58,
                "cond": {
                  "PLpgSQL_expr": {
                    "query": "pending->>'sourcePacketHash' IS DISTINCT FROM material.body->>'sourcePacketHash'\n              OR pending->>'sourcePacketHash' IS DISTINCT FROM 'sha256:'||encode(sha256(material.source_raw),'hex')\n              OR risk_row.body->'originalRisk' IS DISTINCT FROM pending#>'{immutable,origin,immutable,originalRisk}'\n              OR risk_row.body->>'originalRiskHash' IS DISTINCT FROM pending#>>'{immutable,origin,immutable,originalRiskHash}'\n              OR risk_row.body->>'authorityMaterialHash' IS DISTINCT FROM pending->>'authorityMaterialHash'\n              OR risk_row.target_hold::text IS DISTINCT FROM facts#>>'{target,reservationId}'\n              OR risk_row.judge_hold::text IS DISTINCT FROM facts#>>'{judge,reservationId}'\n              OR risk_row.target_request IS DISTINCT FROM facts#>>'{target,requestId}'\n              OR risk_row.judge_request IS DISTINCT FROM facts#>>'{judge,requestId}'\n              OR obligation.physical_account_id::text IS DISTINCT FROM facts#>>'{target,physicalAccountId}'\n              OR obligation.physical_account_id::text IS DISTINCT FROM facts#>>'{judge,physicalAccountId}'",
                    "parseMode": 2
                  }
                },
