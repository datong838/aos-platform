                      }
                    }
                  }
                ],
                "query": {
                  "PLpgSQL_expr": {
                    "query": "SELECT 'initialTargetObligation' AS name,body,content_hash,caller_xid,caller_pid,org_id,project_id FROM aos_shared_parent_physical_private.initial_target_obligation WHERE plan_id=receipt.plan_id\n              UNION ALL SELECT 'targetIntent' AS name,body,content_hash,caller_xid,caller_pid,org_id,project_id FROM aos_shared_parent_physical_private.target_intent WHERE plan_id=receipt.plan_id\n              UNION ALL SELECT 'judgeDependency' AS name,body,content_hash,caller_xid,caller_pid,org_id,project_id FROM aos_shared_parent_physical_private.judge_dependency WHERE plan_id=receipt.plan_id\n              UNION ALL SELECT 'initialCallAuthority' AS name,body,content_hash,caller_xid,caller_pid,org_id,project_id FROM aos_shared_parent_physical_private.initial_call_authority WHERE plan_id=receipt.plan_id\n              UNION ALL SELECT 'initialWindowObligation' AS name,body,content_hash,caller_xid,caller_pid,org_id,project_id FROM aos_shared_parent_physical_private.initial_window_obligation WHERE plan_id=receipt.plan_id\n              UNION ALL SELECT 'completeParentRisk' AS name,body,content_hash,caller_xid,caller_pid,org_id,project_id FROM aos_shared_parent_physical_private.complete_parent_risk WHERE plan_id=receipt.plan_id",
                    "parseMode": 0
                  }
                }
              }
            },
