#define _GNU_SOURCE
#include <sys/prctl.h>
#include <sys/mman.h>
#include <sys/syscall.h>
#include <linux/filter.h>
#include <linux/seccomp.h>
#include <linux/audit.h>
#include <stddef.h>
#include <errno.h>
#include <stdio.h>
#include <unistd.h>
#define DENY (SECCOMP_RET_ERRNO | EPERM)
#define EXEC_FILTER(n) \
 BPF_JUMP(BPF_JMP|BPF_JEQ|BPF_K,(n),0,4), \
 BPF_STMT(BPF_LD|BPF_W|BPF_ABS,offsetof(struct seccomp_data,args[2])), \
 BPF_JUMP(BPF_JMP|BPF_JSET|BPF_K,PROT_EXEC,0,1), \
 BPF_STMT(BPF_RET|BPF_K,DENY), \
 BPF_STMT(BPF_LD|BPF_W|BPF_ABS,offsetof(struct seccomp_data,nr))
int main(void) {
 struct sock_filter filter[]={
 BPF_STMT(BPF_LD|BPF_W|BPF_ABS,offsetof(struct seccomp_data,arch)),
 BPF_JUMP(BPF_JMP|BPF_JEQ|BPF_K,AUDIT_ARCH_AARCH64,1,0),
 BPF_STMT(BPF_RET|BPF_K,SECCOMP_RET_KILL_PROCESS),
 BPF_STMT(BPF_LD|BPF_W|BPF_ABS,offsetof(struct seccomp_data,nr)),
 EXEC_FILTER(__NR_mmap),EXEC_FILTER(__NR_mprotect),
 BPF_STMT(BPF_RET|BPF_K,SECCOMP_RET_ALLOW)};
 struct sock_fprog program={sizeof(filter)/sizeof(filter[0]),filter};
 long size=sysconf(_SC_PAGESIZE);void *p;void *q;int first,second;
 if(size<=0)return 2;
 p=mmap(NULL,(size_t)size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
 if(p==MAP_FAILED)return 3;
 if(prctl(PR_SET_NO_NEW_PRIVS,1,0,0,0)||prctl(PR_SET_SECCOMP,SECCOMP_MODE_FILTER,&program))return 4;
 errno=0;first=mprotect(p,(size_t)size,PROT_READ|PROT_EXEC)==-1 && errno==EPERM;
 errno=0;q=mmap(NULL,(size_t)size,PROT_READ|PROT_EXEC,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);second=q==MAP_FAILED && errno==EPERM;
 if(q!=MAP_FAILED)munmap(q,(size_t)size);
 q=mmap(NULL,(size_t)size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
 if(q==MAP_FAILED)return 5;
 *(volatile char *)q=42;if(*(volatile char *)q!=42)return 6;
 if(munmap(q,(size_t)size)||munmap(p,(size_t)size))return 7;
 printf("{\"mprotect_exec_denied\":%s,\"mmap_exec_denied\":%s,\"rw_memory_usable\":true,\"full_lifecycle_protection\":false}\n",first?"true":"false",second?"true":"false");
 return first && second ? 0:8;
}
