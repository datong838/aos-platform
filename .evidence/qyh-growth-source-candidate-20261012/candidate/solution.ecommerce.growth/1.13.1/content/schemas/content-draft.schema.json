{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aos://solution.ecommerce.growth/content/content-draft.schema.json",
  "title": "ContentDraftProjection",
  "description": "Typed projection over aip_artifact; this schema is not a second draft authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactRef",
    "briefRef",
    "pipeline",
    "variantKey",
    "channel",
    "sourceAssets",
    "evidenceBundleRef",
    "evalReportRef",
    "reviewIssueRefs"
  ],
  "properties": {
    "artifactRef": { "$ref": "#/$defs/contentDraftArtifactRef" },
    "briefRef": { "$ref": "#/$defs/taskBriefRef" },
    "pipeline": { "$ref": "content-pipeline.schema.json" },
    "variantKey": { "type": "string", "minLength": 1, "maxLength": 160 },
    "channel": { "$ref": "#/$defs/channel" },
    "sourceAssets": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/mediaAssetRef" }
    },
    "evidenceBundleRef": { "$ref": "#/$defs/evidenceBundleRef" },
    "evalReportRef": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/evalReportRef" }]
    },
    "reviewIssueRefs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/reviewIssueRef" }
    }
  },
  "$defs": {
    "channel": {
      "enum": ["weapp", "douyin", "kuaishou", "wechat_channels", "xiaohongshu"]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "revision", "contentHash"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "artifactType": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contentDraftArtifactRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "artifactType": { "const": "content_draft" } } }
      ]
    },
    "exactRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "revision", "contentHash"],
      "properties": {
        "resourceType": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "taskBriefRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "TaskBriefRevision" } } }
      ]
    },
    "evidenceBundleRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "EvidenceBundleRevision" } } }
      ]
    },
    "evalReportRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "EvalReportRevision" } } }
      ]
    },
    "reviewIssueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "version"],
      "properties": {
        "resourceType": { "const": "ReviewIssue" },
        "resourceId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "mediaAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "mediaType",
        "usage",
        "provenanceRef",
        "licenseRef",
        "evidenceBundleRef",
        "withdrawalPolicyRef"
      ],
      "properties": {
        "artifactRef": { "$ref": "#/$defs/artifactRef" },
        "mediaType": { "enum": ["image", "audio", "video", "subtitle", "font", "avatar", "document"] },
        "usage": { "enum": ["input", "output", "reference"] },
        "provenanceRef": { "$ref": "#/$defs/exactRevisionRef" },
        "licenseRef": { "$ref": "#/$defs/exactRevisionRef" },
        "evidenceBundleRef": { "$ref": "#/$defs/evidenceBundleRef" },
        "withdrawalPolicyRef": { "$ref": "#/$defs/exactRevisionRef" }
      }
    }
  }
}
