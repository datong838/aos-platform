    "constraints": [
      {
        "conname": "asset_bundle_version_event_actor_check",
        "definition": "CHECK ((btrim(actor) <> ''::text))"
      },
      {
        "conname": "asset_bundle_version_event_check",
        "definition": "CHECK ((from_status <> to_status))"
      },
      {
        "conname": "asset_bundle_version_event_evidence_revision_check",
        "definition": "CHECK ((evidence_revision ~ '^sha256:[0-9a-f]{64}$'::text))"
      },
      {
        "conname": "asset_bundle_version_event_evidence_snapshot_check",
        "definition": "CHECK (((evidence_snapshot IS NULL) OR (jsonb_typeof(evidence_snapshot) = 'array'::text)))"
      },
      {
        "conname": "asset_bundle_version_event_from_status_check",
        "definition": "CHECK ((from_status = ANY (ARRAY['draft'::text, 'validated'::text, 'published'::text, 'deprecated'::text, 'revoked'::text, 'rejected'::text])))"
      },
      {
        "conname": "asset_bundle_version_event_pkey",
        "definition": "PRIMARY KEY (event_pk)"
      },
      {
        "conname": "asset_bundle_version_event_sequence_check",
        "definition": "CHECK ((sequence > 0))"
      },
      {
        "conname": "asset_bundle_version_event_to_status_check",
        "definition": "CHECK ((to_status = ANY (ARRAY['draft'::text, 'validated'::text, 'published'::text, 'deprecated'::text, 'revoked'::text, 'rejected'::text])))"
      },
      {
        "conname": "asset_bundle_version_event_version_pk_fkey",
        "definition": "FOREIGN KEY (version_pk) REFERENCES asset_bundle_version(version_pk) ON DELETE RESTRICT"
      },
      {
        "conname": "asset_bundle_version_event_version_pk_sequence_key",
        "definition": "UNIQUE (version_pk, sequence)"
      }
    ],
    "triggers": [
      {
        "tgname": "trg_asset_bundle_version_event_guard",
        "tgenabled": "O",
        "definition": "CREATE TRIGGER trg_asset_bundle_version_event_guard BEFORE INSERT OR DELETE OR UPDATE ON public.asset_bundle_version_event FOR EACH ROW EXECUTE FUNCTION guard_asset_bundle_version_event_mutation()",
