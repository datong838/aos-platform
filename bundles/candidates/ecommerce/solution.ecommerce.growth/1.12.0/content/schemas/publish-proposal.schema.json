{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aos://solution.ecommerce.growth/content/publish-proposal.schema.json",
  "title": "PublishProposalPayload",
  "description": "Proposal-only payload for AIP-3 ActionProposal. It cannot represent publication success.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionType",
    "contentDraftRef",
    "channel",
    "accountRef",
    "harnessRevisionRef",
    "impactPreviewRef",
    "evidenceBundleRef",
    "requestedMode",
    "scheduledAt"
  ],
  "properties": {
    "actionType": { "const": "publish_content" },
    "contentDraftRef": { "$ref": "#/$defs/contentDraftArtifactRef" },
    "channel": { "$ref": "#/$defs/channel" },
    "accountRef": { "$ref": "#/$defs/platformAccountBindingRef" },
    "harnessRevisionRef": { "$ref": "#/$defs/platformHarnessRef" },
    "impactPreviewRef": { "$ref": "#/$defs/impactPreviewRef" },
    "evidenceBundleRef": { "$ref": "#/$defs/evidenceBundleRef" },
    "requestedMode": { "const": "proposal_only" },
    "scheduledAt": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    }
  },
  "$defs": {
    "channel": {
      "enum": ["weapp", "douyin", "kuaishou", "wechat_channels", "xiaohongshu"]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "revision", "contentHash"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "artifactType": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contentDraftArtifactRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "artifactType": { "const": "content_draft" } } }
      ]
    },
    "exactRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "revision", "contentHash"],
      "properties": {
        "resourceType": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "platformAccountBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "version"],
      "properties": {
        "resourceType": { "const": "PlatformAccountBinding" },
        "resourceId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "platformHarnessRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "PlatformHarnessRevision" } } }
      ]
    },
    "impactPreviewRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "ImpactPreviewRevision" } } }
      ]
    },
    "evidenceBundleRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "EvidenceBundleRevision" } } }
      ]
    }
  }
}
