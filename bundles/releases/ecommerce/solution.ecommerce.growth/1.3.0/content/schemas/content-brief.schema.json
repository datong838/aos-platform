{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aos://solution.ecommerce.growth/content/content-brief.schema.json",
  "title": "ContentBriefSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "briefType",
    "objective",
    "deliverableKinds",
    "channelTargets",
    "productRefs",
    "audienceRefs",
    "evidenceBundleRef",
    "factualClaimPolicy",
    "contentConstraints",
    "cutoffAt"
  ],
  "properties": {
    "briefType": { "const": "content_campaign" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "deliverableKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["seed_copy", "short_video", "live_plan", "platform_variant"] }
    },
    "channelTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/channel" }
    },
    "productRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/resourceRef" }
    },
    "audienceRefs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/resourceRef" }
    },
    "evidenceBundleRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRevisionRef" },
        { "properties": { "resourceType": { "const": "EvidenceBundleRevision" } } }
      ]
    },
    "factualClaimPolicy": { "const": "evidence_only" },
    "contentConstraints": { "type": "object" },
    "cutoffAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "channel": {
      "enum": ["weapp", "douyin", "kuaishou", "wechat_channels", "xiaohongshu"]
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "revision", "authority"],
      "properties": {
        "resourceType": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 }
      }
    },
    "exactRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId", "revision", "contentHash"],
      "properties": {
        "resourceType": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
