{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.dev/schemas/asset-bundles/knowledge-package-v1alpha1.schema.json",
  "title": "AOS Knowledge Package v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "packageId",
    "packageVersion",
    "sourceInventory",
    "rollback"
  ],
  "properties": {
    "apiVersion": {
      "const": "aos.dev/knowledge-package/v1alpha1"
    },
    "kind": {
      "const": "KnowledgePackage"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sourceInventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "rollback": {
      "$ref": "#/$defs/rollback"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceUri",
        "observedAt",
        "freshnessExpiresAt",
        "licenseId",
        "usagePolicy",
        "licenseDecision",
        "contentHash",
        "provider",
        "providerVersion"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/capabilityId"
        },
        "sourceUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "freshnessExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "licenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "usagePolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "licenseDecision": {
          "enum": ["allowed", "denied", "unknown"]
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "category",
        "payloadPath",
        "payloadHash",
        "sourceId",
        "markings",
        "applicability",
        "ownerRoles"
      ],
      "properties": {
        "entryId": {
          "$ref": "#/$defs/capabilityId"
        },
        "category": {
          "$ref": "#/$defs/capabilityId"
        },
        "payloadPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "payloadHash": {
          "$ref": "#/$defs/sha256"
        },
        "sourceId": {
          "$ref": "#/$defs/capabilityId"
        },
        "markings": {
          "$ref": "#/$defs/scopeList"
        },
        "applicability": {
          "$ref": "#/$defs/scopeList"
        },
        "ownerRoles": {
          "$ref": "#/$defs/scopeList"
        }
      }
    },
    "scopeList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "receiptRequired"],
      "properties": {
        "mode": {
          "const": "remove-projection-retain-canonical"
        },
        "receiptRequired": {
          "const": true
        }
      }
    }
  }
}
