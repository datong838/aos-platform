  "functions": {
    "public.aip_budget_cost_issuer_guard_a0v_125()": {
      "definition": "CREATE OR REPLACE FUNCTION public.aip_budget_cost_issuer_guard_a0v_125()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$ BEGIN\n      IF session_user<>'aos_budget_cost_issuer' OR current_user<>'aos_runtime'\n         OR current_setting('aos.org_id',true) IS DISTINCT FROM NEW.org_id\n         OR current_setting('aos.project_id',true) IS DISTINCT FROM NEW.project_id\n         OR EXISTS(SELECT 1 FROM pg_roles WHERE rolname=session_user AND\n           (NOT rolcanlogin OR rolinherit OR rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls))\n         OR EXISTS(SELECT 1 FROM pg_auth_members WHERE roleid=session_user::regrole\n           OR (member=session_user::regrole AND (roleid<>'aos_runtime'::regrole OR admin_option))) THEN\n        RAISE EXCEPTION 'BUDGET_COST_ISSUER_REQUIRED' USING ERRCODE='42501';\n      END IF;\n      IF TG_TABLE_NAME='aip_budget_cost_decision' THEN\n        IF NEW.expires_at<=clock_timestamp() OR NOT EXISTS(\n          SELECT 1 FROM public.aip_budget_cost_proposal p WHERE p.org_id=NEW.org_id\n            AND p.project_id=NEW.project_id AND p.proposal_id=NEW.proposal_id\n            AND p.proposal_hash=NEW.proposal_hash AND p.checker_subject=NEW.actor_subject\n            AND p.expires_at=NEW.expires_at) THEN\n          RAISE EXCEPTION 'BUDGET_COST_EXACT_CURRENT_PROPOSAL_REQUIRED' USING ERRCODE='42501';\n        END IF;\n      END IF;\n      RETURN NEW; END $function$\n",
      "acl": [
        [
          "<owner>",
          "EXECUTE",
          false
        ]
      ]
    },
    "public.extension_reject_history_mutation()": {
      "definition": "CREATE OR REPLACE FUNCTION public.extension_reject_history_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\n      BEGIN RAISE EXCEPTION 'extension history is immutable'; END\n    $function$\n",
      "acl": [
        [
          "<owner>",
          "EXECUTE",
          false
        ],
        [
          "PUBLIC",
          "EXECUTE",
          false
        ]
      ]
    },
    "public.aip_budget_cost_fence_guard_a0v_126()": {
      "definition": "CREATE OR REPLACE FUNCTION public.aip_budget_cost_fence_guard_a0v_126()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$ BEGIN\n      IF TG_OP='INSERT' THEN\n        IF session_user<>'aos_budget_consumer_call' OR current_user<>'aos_budget_consumer_owner' OR NEW.version<>1 THEN\n          RAISE EXCEPTION 'BUDGET_COST_FENCE_CONSUMER_REQUIRED' USING ERRCODE='42501'; END IF;\n      ELSIF TG_OP='UPDATE' THEN\n        IF (NEW.org_id,NEW.project_id,NEW.budget_id,NEW.revision,NEW.decision_id) IS DISTINCT FROM\n           (OLD.org_id,OLD.project_id,OLD.budget_id,OLD.revision,OLD.decision_id) OR NEW.version<>OLD.version+1 THEN\n          RAISE EXCEPTION 'BUDGET_COST_FENCE_DRIFT' USING ERRCODE='23514'; END IF;\n      ELSE RAISE EXCEPTION 'BUDGET_COST_FENCE_HISTORY_REQUIRED'; END IF;\n      RETURN NEW; END $function$\n",
      "acl": [
        [
          "<owner>",
          "EXECUTE",
          false
        ]
      ]
    },
    "public.aip_budget_cost_revoke_fence_a0v_126()": {
      "definition": "CREATE OR REPLACE FUNCTION public.aip_budget_cost_revoke_fence_a0v_126()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$ BEGIN\n      UPDATE public.aip_budget_cost_runtime_fence SET version=version+1\n        WHERE org_id=NEW.org_id AND project_id=NEW.project_id AND decision_id=NEW.decision_id;\n      RETURN NEW; END $function$\n",
      "acl": [
        [
          "<owner>",
          "EXECUTE",
          false
        ]
      ]
    }
